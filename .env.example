# Copy to server/.env and replace the placeholders. Never commit the real .env file.
# Type real values only in your local file, never in chat or in git.

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL (placeholders only) ---
# DB_NAME must NOT end in "_test" here; the test database is configured in server/.env.test.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_dev
DB_USER=inventory_app
DB_PASSWORD=your_database_password

# --- Authentication (used in a later phase) ---
# At least 32 random characters. Generate one locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
