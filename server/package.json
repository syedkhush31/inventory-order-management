{
  "name": "inventory-order-management-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Inventory & Order Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --passWithNoTests",
    "db:check": "node scripts/db-check.js",
    "test:unit": "jest --runInBand --passWithNoTests tests/unit",
    "test:integration": "jest --runInBand --passWithNoTests tests/integration",
    "admin:create": "node scripts/create-admin.js",
    "db:check:test": "node scripts/db-check.js --env=test"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
