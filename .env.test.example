# Copy to server/.env.test. Used automatically when NODE_ENV=test (Jest sets this).
# DB_NAME MUST end in "_test" or the app and test helpers will refuse to run.

NODE_ENV=test
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_test
DB_USER=inventory_app
DB_PASSWORD=your_database_password

# At least 32 random characters, different from the dev secret.
JWT_SECRET=replace_with_a_different_long_random_string
